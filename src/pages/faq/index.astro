              target="_blank"
              rel="nofollow sponsored noopener"
              class="mt-4 flex w-full items-center justify-center rounded-xl bg-brand-dark px-4 py-3 text-sm font-bold text-white shadow-sm hover:bg-brand-primary transition-colors"
            >
              直达光速云官网选购 ↗
            </a>

            <!-- 更多实测梯队链接 -->
            <div class="mt-6 pt-5 border-t border-brand-dark/10">
              <h4 class="text-xs font-bold text-brand-dark/80 uppercase tracking-wider mb-3">
                更多实测第一梯队稳定商家
              </h4>
              <ul class="space-y-2.5">
                {topAirports.slice(1, 5).map(ap => (
