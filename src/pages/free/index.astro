                  {item.badge}
                </span>
                <h3 class="text-lg font-bold text-brand-dark mb-2">
                  {item.type}
                </h3>
                <p class="text-xs sm:text-sm text-brand-dark/70 leading-relaxed mb-4">
                  {item.desc}
                </p>
