          </p>
        </div>

        <!-- 对比表格 -->
        <div class="overflow-x-auto rounded-2xl border border-brand-dark/10 bg-white mb-8 shadow-sm">
          <table class="w-full text-left text-xs sm:text-sm">
            <thead class="bg-brand-dark/[0.03] text-brand-dark/80 border-b border-brand-dark/10">
              <tr>
                <th class="p-4 font-bold">评测对比维度</th>
