        </p>

        <!-- 目录快速跳转导航 -->
        <div class="mt-8 flex flex-wrap justify-center gap-2">
          {faqCategories.map(cat => (
            <a
              href={`#${cat.id}`}
              class="rounded-lg border border-brand-dark/10 bg-white/70 px-3 py-1.5 text-xs font-medium text-brand-dark/80 hover:border-brand-primary hover:text-brand-primary transition-all shadow-sm"
