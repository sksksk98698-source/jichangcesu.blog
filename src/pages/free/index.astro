// 免费 vs 付费专线对比实测
const compareData = [
  { item: "晚高峰 20:00 丢包率", free: "25% ~ 60%（频繁断流）", paid: "0%（企业专线端内穿透）" },
  { item: "YouTube 4K 加载速度", free: "严重缓冲或降至 720P", paid: "秒开 4K，缓冲区 15 秒以上" },
  { item: "ChatGPT / Claude 登录", free: "90% 提示机房被拉黑", paid: "稳定识别为原生住宅环境" },
  { item: "单节点有效存活期", free: "通常数小时至 2 天即失效", paid: "365 天专职运维集群保障" },
  { item: "隐私与安全性", free: "存在流量被中间人监听风险", paid: "知名正规协议全程加密" },
  { item: "每日维护时间成本", free: "每天耗费 30 分钟到处找节点", paid: "0 维护，开机即可无感使用" }
