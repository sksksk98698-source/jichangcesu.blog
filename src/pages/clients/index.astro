---
import Layout from "@layouts/Layout.astro";
import clientSections from "@data/clients.json";

const seoTitle = "2026 机场代理客户端大全及配置教程 · 机场测试 (jichangcesu.blog)";
const seoDescription = "全平台机场第三方代理客户端下载与配置指南。收录 Windows (Clash Verge Rev, v2rayN)、Android (v2rayNG, FlClash)、iOS (Shadowrocket)、macOS 与软路由最新客户端推荐。";
---

<Layout title={seoTitle} description={seoDescription} fullBleedTop={false}>
  <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"首页","item":"https://jichangcesu.blog/"},{"@type":"ListItem","position":2,"name":"机场客户端大全","item":"https://jichangcesu.blog/clients/"}]})} />
  <div class="relative min-h-screen py-12 sm:py-16 bg-brand-page text-brand-dark">
    <!-- 顶部渐变微光 -->
    <div class="pointer-events-none absolute inset-x-0 top-0 h-96 bg-gradient-to-b from-brand-accent/10 to-transparent blur-3xl opacity-60" aria-hidden="true"></div>

    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- 页面头部 -->
      <div class="mx-auto max-w-3xl text-center mb-12 sm:mb-16">
        <div class="inline-flex items-center gap-2 rounded-full border border-brand-accent/30 bg-brand-accent/5 px-4 py-1.5 text-xs font-semibold text-brand-accent mb-4">
          <span>全平台覆盖 · 官方纯净开源客户端</span>
        </div>
        <h1 class="text-3xl font-extrabold tracking-tight sm:text-5xl text-brand-dark">
          2026 机场代理客户端大全
        </h1>
        <p class="mt-4 text-base sm:text-lg text-brand-dark/70 leading-relaxed">
          机场代理客户端主要分为<strong>第三方开源通用客户端</strong>（推荐，可自由导入各类机场通用订阅）与<strong>服务商定制专属客户端</strong>。以下按主流操作系统整理，助你快速完成配置。
        </p>

        <!-- 快速定位导航锚点 -->
        <div class="mt-8 flex flex-wrap justify-center gap-2">
          {clientSections.map((sec) => (
            <a
              href={`#${sec.platform.split(' ')[0].toLowerCase()}`}
              class="rounded-xl border border-brand-dark/10 bg-white px-3.5 py-1.5 text-xs font-semibold text-brand-dark hover:border-brand-primary hover:text-brand-primary transition-all shadow-2xs"
            >
              {sec.platform.split(' ')[0]}
            </a>
          ))}
        </div>
      </div>

      <!-- 分平台客户端列表 -->
      <div class="space-y-12">
        {clientSections.map((sec) => {
          const anchorId = sec.platform.split(' ')[0].toLowerCase();
          return (
            <div id={anchorId} class="scroll-mt-24 rounded-3xl border border-brand-dark/10 bg-white p-6 sm:p-8 shadow-sm">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 mb-6 border-b border-brand-dark/5 gap-2">
                <div>
                  <h2 class="text-xl sm:text-2xl font-bold text-brand-dark flex items-center gap-2">
                    <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-accent text-brand-dark text-sm font-bold">
                      {sec.platform.slice(0, 1)}
                    </span>
                    {sec.platform}
                  </h2>
                  <p class="text-xs sm:text-sm text-brand-dark/60 mt-1">{sec.description}</p>
                </div>
                <span class="inline-block rounded-full bg-brand-dark/5 px-3 py-1 text-xs font-semibold text-brand-dark/70 self-start sm:self-auto">
                  收录 {sec.items.length} 款主流工具
                </span>
              </div>

              <!-- 客户端卡片网格 -->
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {sec.items.map((item) => (
                  <div class="rounded-2xl border border-brand-dark/5 bg-brand-dark/[0.015] p-5 hover:border-brand-primary/30 transition-all flex flex-col justify-between">
                    <div>
                      <div class="flex items-center justify-between mb-2">
                        <h3 class="text-base font-bold text-brand-dark">{item.name}</h3>
                        <span class="rounded bg-brand-dark/5 px-2 py-0.5 text-[11px] font-semibold text-brand-dark/60">
                          {item.source}
                        </span>
                      </div>
                      <p class="text-xs text-brand-dark/70 leading-relaxed mb-4">
                        {item.features}
                      </p>
                    </div>

                    <div class="pt-3 border-t border-brand-dark/5">
                      <a
                        href={item.source.includes('App Store') ? "https://www.apple.com/app-store/" : "https://github.com"}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-primary hover:text-brand-accent transition-colors"
                      >
                        获取客户端项目 / 下载
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                      </a>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          );
        })}
      </div>

      <!-- 客户端常见避坑与配置要点 -->
      <div class="mt-16 rounded-3xl border border-brand-accent/20 bg-gradient-to-br from-brand-accent/5 to-transparent p-6 sm:p-10">
        <h3 class="text-xl font-bold text-brand-dark mb-4 flex items-center gap-2">
          <span>💡</span> 客户端选型与配置通用指南
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs sm:text-sm text-brand-dark/80 leading-relaxed">
          <div class="rounded-2xl bg-white p-5 border border-brand-dark/10 shadow-2xs">
            <h4 class="font-bold text-brand-dark mb-2 text-sm">1. 认准开源官方 Release</h4>
            <p>请勿通过百度或不知名第三方下载站下载所谓的“绿色汉化版”，极易被植入恶意后门。本站推荐的 Clash Verge Rev、v2rayN 均为开源项目，直接从 GitHub Release 下载签名包最为安全。</p>
          </div>
          <div class="rounded-2xl bg-white p-5 border border-brand-dark/10 shadow-2xs">
            <h4 class="font-bold text-brand-dark mb-2 text-sm">2. 订阅导入首选 Clash / V2Ray 格式</h4>
            <p>在机场后台（如光速云）复制订阅链接时，点击「一键导入 Clash」或「复制通用订阅链接」，粘贴至客户端配置列表并更新即可自动拉取最新节点。</p>
          </div>
          <div class="rounded-2xl bg-white p-5 border border-brand-dark/10 shadow-2xs">
            <h4 class="font-bold text-brand-dark mb-2 text-sm">3. 开启 TUN 模式或规则分流</h4>
            <p>日常使用推荐「规则分流（Rule Mode）」，国内网站直连不消耗机场流量；需要接管 Telegram 电脑端或外服游戏时，可在 Clash Verge Rev 中打开「TUN 模式」。</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
