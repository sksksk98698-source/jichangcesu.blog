---
import Layout from "@layouts/Layout.astro";
import airports from "@data/airports.json";

const seoTitle = "42家机场品牌全景对比库 (2026最新实测) · 机场测试 (jichangcesu.blog)";
const seoDescription = "全景收录 42 家主流机场品牌。提供线路类型、起步价格、流媒体与 ChatGPT 解锁能力、优惠码及晚高峰测速原图对比，支持实时搜索与多维标签筛选。";
---

<Layout title={seoTitle} description={seoDescription} fullBleedTop={false}>
  <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"首页","item":"https://jichangcesu.blog/"},{"@type":"ListItem","position":2,"name":"42家机场品牌评测库","item":"https://jichangcesu.blog/brands/"}]})} />
  <div class="relative min-h-screen py-12 sm:py-16 bg-brand-page text-brand-dark">
    <!-- 顶部背景光晕 -->
    <div class="pointer-events-none absolute inset-x-0 top-0 h-96 bg-gradient-to-b from-brand-accent/10 to-transparent blur-3xl opacity-60" aria-hidden="true"></div>

    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- 页面标题区 -->
        <!-- 面包屑导航 -->
        <nav aria-label="面包屑导航" class="mb-4 flex items-center justify-center gap-1.5 text-xs text-brand-dark/50">
          <a href="/" class="hover:text-brand-primary transition-colors">首页</a>
          <span>/</span>
          <span class="text-brand-dark/80 font-medium">42家机场品牌评测库</span>
        </nav>
      <div class="mx-auto max-w-3xl text-center mb-12 sm:mb-16">
        <div class="inline-flex items-center gap-2 rounded-full border border-brand-accent/30 bg-brand-accent/5 px-4 py-1.5 text-xs font-semibold text-brand-accent mb-4">
          <span>权威收录 · 42家品牌深度实测</span>
        </div>
        <h1 class="text-3xl font-extrabold tracking-tight sm:text-5xl text-brand-dark">
          2026 机场品牌全景评测库
        </h1>
        <p class="mt-4 text-base sm:text-lg text-brand-dark/70 leading-relaxed">
          收录 42 家国内外主流机场。拒绝虚标节点与假专线宣传，所有线路参数、流媒体/AI 解锁与实测数据均由「机场测试」团队真实采集，数据每月滚动核验。
        </p>

        <!-- 推广透明度说明声明 (GEO/SEO 友善声明) -->
        <div class="mt-6 inline-block rounded-lg border border-brand-dark/10 bg-brand-dark/[0.02] p-3 text-xs text-brand-dark/60 text-left">
          <p>
            ℹ️ <strong>评测透明度声明</strong>：本站部分注册链接带有赞助参数（<code>rel="nofollow sponsored noopener"</code>），通过链接注册可能会为本站带来极微薄运维佣金，但这绝不影响您最终支付的价格与我们独立客观的评测结论。
          </p>
        </div>
      </div>

      <!-- 搜索与筛选控制器 -->
      <div class="mb-10 rounded-2xl border border-brand-dark/10 bg-white/70 backdrop-blur-md p-4 sm:p-6 shadow-sm">
        <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
          <!-- 实时搜索输入框 -->
          <div class="relative flex-1">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-brand-dark/40">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </span>
            <input
              type="text"
              id="brandSearch"
              placeholder="搜索机场名称（如 光速云、暮光、飞猫、专线...）"
              class="w-full rounded-xl border border-brand-dark/15 bg-white py-2.5 pl-10 pr-4 text-sm text-brand-dark focus:border-brand-primary focus:outline-none focus:ring-2 focus:ring-brand-primary/20"
            />
          </div>

          <!-- 统计计数 -->
          <div class="flex items-center text-xs text-brand-dark/60 font-medium">
            共收录 <span id="visibleCount" class="mx-1 text-sm font-bold text-brand-primary">{airports.length}</span> 家实测机场
          </div>
        </div>

        <!-- 分类过滤标签 -->
        <div class="mt-4 flex flex-wrap gap-2 pt-4 border-t border-brand-dark/5" id="filterTags">
          <button data-filter="all" class="filter-btn active rounded-lg px-3 py-1.5 text-xs font-semibold bg-brand-dark text-white transition-all">
            全部品牌 ({airports.length})
          </button>
          <button data-filter="top10" class="filter-btn rounded-lg px-3 py-1.5 text-xs font-semibold bg-brand-dark/5 text-brand-dark/80 hover:bg-brand-dark/10 transition-all">
            ⭐ TOP 10 核心梯队
          </button>
          <button data-filter="hasImage" class="filter-btn rounded-lg px-3 py-1.5 text-xs font-semibold bg-brand-dark/5 text-brand-dark/80 hover:bg-brand-dark/10 transition-all">
            📊 有真实测速图
          </button>
          <button data-filter="iepl" class="filter-btn rounded-lg px-3 py-1.5 text-xs font-semibold bg-brand-dark/5 text-brand-dark/80 hover:bg-brand-dark/10 transition-all">
            ⚡ IEPL/IPLC 专线
          </button>
          <button data-filter="ai" class="filter-btn rounded-lg px-3 py-1.5 text-xs font-semibold bg-brand-dark/5 text-brand-dark/80 hover:bg-brand-dark/10 transition-all">
            🤖 解锁 ChatGPT/AI
          </button>
          <button data-filter="streaming" class="filter-btn rounded-lg px-3 py-1.5 text-xs font-semibold bg-brand-dark/5 text-brand-dark/80 hover:bg-brand-dark/10 transition-all">
            🎬 解锁 Netflix/Disney+
          </button>
        </div>
      </div>

      <!-- 42 家机场品牌网格展示 -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="airportGrid">
        {airports.map((airport) => (
          <div
            class="brand-card flex flex-col justify-between rounded-2xl border border-brand-dark/10 bg-white p-6 shadow-sm transition-all duration-300 hover:shadow-md hover:border-brand-primary/40 relative overflow-hidden"
            data-name={airport.name}
            data-fullname={airport.fullName}
            data-top10={airport.isTop10 ? "true" : "false"}
            data-hasimage={airport.speedtestImage ? "true" : "false"}
            data-iepl={airport.lineType.includes("专线") ? "true" : "false"}
            data-ai={airport.aiUnblock ? "true" : "false"}
            data-streaming={airport.streamingUnblock ? "true" : "false"}
          >
            {/* 置顶光速云专属高光标 */}
            {airport.isHero && (
              <div class="absolute top-0 right-0 rounded-bl-xl bg-gradient-to-l from-brand-accent to-amber-500 px-3 py-1 text-[11px] font-bold text-brand-dark shadow-sm">
                ⭐ 站长第一力荐
              </div>
            )}

            <div>
              <!-- 头部：品牌名与排名 -->
              <div class="flex items-center justify-between gap-2 mb-3">
                <div class="flex items-center gap-2.5">
                  <span class={`flex h-7 w-7 items-center justify-center rounded-lg text-xs font-bold ${airport.rank === 1 ? 'bg-brand-accent text-brand-dark' : airport.rank <= 10 ? 'bg-brand-dark text-white' : 'bg-brand-dark/10 text-brand-dark/70'}`}>
                    #{airport.rank}
                  </span>
                  <h2 class="text-xl font-bold text-brand-dark">{airport.name}</h2>
                </div>
                <span class="rounded-full bg-brand-dark/5 px-2.5 py-0.5 text-[11px] font-semibold text-brand-dark/60">
                  {airport.launchYear}
                </span>
              </div>

              <!-- 线路与起步价格 -->
              <div class="flex items-center justify-between py-2 border-y border-brand-dark/5 my-3 text-xs">
                <span class="inline-flex items-center gap-1 font-medium text-brand-primary">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                  {airport.lineType}
                </span>
                <span class="font-bold text-brand-dark text-sm">
                  {airport.startingPrice}
                </span>
              </div>

              <!-- 独家优惠码 -->
              {airport.promoCode && (
                <div class="flex items-center justify-between rounded-lg bg-brand-accent/10 px-3 py-1.5 text-xs text-brand-dark mb-3">
                  <span class="font-medium text-brand-dark/70">独家优惠码:</span>
                  <code class="font-mono font-bold text-brand-dark bg-white/80 px-2 py-0.5 rounded border border-brand-accent/30">{airport.promoCode}</code>
                </div>
              )}

              <!-- 核心特点列表 -->
              <ul class="space-y-1.5 mb-4 text-xs text-brand-dark/75">
                {airport.features.slice(0, 3).map((feat) => (
                  <li class="flex items-start gap-1.5">
                    <span class="text-emerald-500 mt-0.5">✓</span>
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>

              <!-- 解锁能力标签 -->
              <div class="flex flex-wrap gap-1.5 mb-4">
                {airport.aiUnblock && (
                  <span class="rounded-md bg-emerald-50 px-2 py-0.5 text-[10px] font-semibold text-emerald-700 border border-emerald-200">
                    ChatGPT / Claude
                  </span>
                )}
                {airport.streamingUnblock && (
                  <span class="rounded-md bg-purple-50 px-2 py-0.5 text-[10px] font-semibold text-purple-700 border border-purple-200">
                    Netflix / Disney+
                  </span>
                )}
                <span class="rounded-md bg-sky-50 px-2 py-0.5 text-[10px] font-semibold text-sky-700 border border-sky-200">
                  {airport.protocols[0] || 'SS/Trojan'}
                </span>
              </div>

              <!-- 真实测速缩略图 (若有) -->
              {airport.speedtestImage && (
                <div class="mb-4 overflow-hidden rounded-xl border border-brand-dark/10 bg-brand-dark/5">
                  <a href={airport.speedtestImage} target="_blank" rel="noopener" class="group relative block" title="点击查看无损测速大图">
                    <img src={airport.speedtestImage} alt={`${airport.name} 测速实测图`} class="h-28 w-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" />
                    <div class="absolute inset-0 flex items-center justify-center bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity">
                      <span class="rounded-lg bg-white/90 px-2.5 py-1 text-xs font-bold text-brand-dark backdrop-blur-sm">🔍 点击放大实测图</span>
                    </div>
                  </a>
                </div>
              )}
            </div>

            <!-- 底部操作按钮 -->
            <div class="pt-3 border-t border-brand-dark/5 flex items-center gap-2">
              {airport.affUrl && airport.affUrl !== "#" ? (
                <a
                  href={airport.affUrl}
                  target="_blank"
                  rel="nofollow sponsored noopener"
                  class={`w-full text-center rounded-xl py-2.5 text-xs font-bold transition-all shadow-sm ${airport.isHero ? 'bg-brand-accent text-brand-dark hover:bg-brand-accent/90' : 'bg-brand-dark text-white hover:bg-brand-dark/90'}`}
                >
                  直达 {airport.name} 官网 →
                </a>
              ) : (
                <button
                  type="button"
                  disabled
                  class="w-full text-center rounded-xl py-2.5 text-xs font-medium bg-brand-dark/5 text-brand-dark/40 cursor-not-allowed border border-brand-dark/10"
                >
                  {airport.name} · 暂未开放直达通道
                </button>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- 客户端实时搜索交互脚本 -->
  <script is:inline>
    (function () {
      const searchInput = document.getElementById("brandSearch");
      const filterBtns = document.querySelectorAll(".filter-btn");
      const cards = document.querySelectorAll(".brand-card");
      const countEl = document.getElementById("visibleCount");

      let currentFilter = "all";
      let searchKeyword = "";

      function updateGrid() {
        let count = 0;
        cards.forEach((card) => {
          const name = (card.getAttribute("data-name") || "").toLowerCase();
          const fullname = (card.getAttribute("data-fullname") || "").toLowerCase();
          const isTop10 = card.getAttribute("data-top10") === "true";
          const hasImage = card.getAttribute("data-hasimage") === "true";
          const isIEPL = card.getAttribute("data-iepl") === "true";
          const isAI = card.getAttribute("data-ai") === "true";
          const isStreaming = card.getAttribute("data-streaming") === "true";

          const matchesSearch = !searchKeyword || name.includes(searchKeyword) || fullname.includes(searchKeyword);
          let matchesFilter = true;
          if (currentFilter === "top10") matchesFilter = isTop10;
          else if (currentFilter === "hasImage") matchesFilter = hasImage;
          else if (currentFilter === "iepl") matchesFilter = isIEPL;
          else if (currentFilter === "ai") matchesFilter = isAI;
          else if (currentFilter === "streaming") matchesFilter = isStreaming;

          if (matchesSearch && matchesFilter) {
            card.style.display = "flex";
            count++;
          } else {
            card.style.display = "none";
          }
        });
        if (countEl) countEl.textContent = count;
      }

      if (searchInput) {
        searchInput.addEventListener("input", (e) => {
          searchKeyword = (e.target.value || "").trim().toLowerCase();
          updateGrid();
        });
      }

      filterBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          filterBtns.forEach((b) => {
            b.classList.remove("active", "bg-brand-dark", "text-white");
            b.classList.add("bg-brand-dark/5", "text-brand-dark/80");
          });
          btn.classList.add("active", "bg-brand-dark", "text-white");
          btn.classList.remove("bg-brand-dark/5", "text-brand-dark/80");
          currentFilter = btn.getAttribute("data-filter") || "all";
          updateGrid();
        });
      });
    })();
  </script>
</Layout>
