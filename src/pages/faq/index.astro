                    <div class="mt-3.5 pt-3 border-t border-brand-dark/5 text-xs sm:text-sm text-brand-dark/80 leading-relaxed whitespace-pre-line pl-2">
                      💡 {item.a}
                    </div>
                  </details>
                ))}
              </div>
            </section>
          ))}
        </div>

        <!-- 右侧 4 列：推荐品牌转化侧边栏挂件 -->
        <div class="lg:col-span-4 space-y-6">
          
          <!-- 核心推荐卡片：光速云 -->
          <div class="sticky top-24 rounded-2xl border-2 border-brand-accent/40 bg-white p-6 shadow-md">
            <div class="flex items-center justify-between mb-3">
              <span class="rounded bg-brand-accent px-2 py-0.5 text-xs font-bold text-white">
                综合评分榜首 · 2026 首推
              </span>
