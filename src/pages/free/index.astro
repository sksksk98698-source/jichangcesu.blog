---

<Layout title={seoTitle} description={seoDescription} fullBleedTop={false}>
  <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"首页","item":"https://jichangcesu.blog/"},{"@type":"ListItem","position":2,"name":"免费资源与网络工具箱","item":"https://jichangcesu.blog/free/"}]})} />
  <div class="relative min-h-screen py-12 sm:py-16 bg-brand-page text-brand-dark">
    <!-- 顶部渐变流光背景 -->
    <div class="pointer-events-none absolute inset-x-0 top-0 h-96 bg-gradient-to-b from-brand-accent/10 to-transparent blur-3xl opacity-60" aria-hidden="true"></div>

    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      
      <!-- 页面顶部 Header -->
        <!-- 面包屑导航 -->
        <nav aria-label="面包屑导航" class="mb-4 flex items-center justify-center gap-1.5 text-xs text-brand-dark/50">
          <a href="/" class="hover:text-brand-primary transition-colors">首页</a>
          <span>/</span>
          <span class="text-brand-dark/80 font-medium">免费资源与网络工具箱</span>
        </nav>
      <div class="mx-auto max-w-3xl text-center mb-12 sm:mb-16">
        <div class="inline-flex items-center gap-2 rounded-full border border-brand-accent/30 bg-brand-accent/5 px-4 py-1.5 text-xs font-semibold text-brand-accent mb-4">
          <span>🎁 免费通道 · 工具箱 · 避坑实测</span>
        </div>
        <h1 class="text-3xl font-extrabold tracking-tight sm:text-5xl text-brand-dark">
          2026 免费翻墙资源与网络工具箱
