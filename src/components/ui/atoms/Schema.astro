---
import companyRaw from '@data/global/company.json';
import seo from '@data/global/seo.json';
import type { CompanyConfig } from '@/types/config';
import { getSocialUrls } from '@utils/socials';
import { SITE_URL } from '../../../../site.config.mjs';

interface Props {
	/** `affiliate` — tylko lekki WebSite (strona afiliacyjna), bez LocalBusiness z danych globalnych. */
	template?: 'default' | 'affiliate';
}

const { template = 'default' } = Astro.props;

// Why: JSON.stringify does not escape '<', which inside set:html
// could be interpreted as an HTML tag opening (XSS vector via
// JSON data). Escaping to \u003c neutralizes it, and JSON-LD parses identically.
const jsonLd = (data: object): string => JSON.stringify(data).replace(/</g, '\\u003c');

const company = companyRaw as CompanyConfig;
const siteBase = SITE_URL.replace(/\/$/, '');
const affiliateWebsiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'Affiliate',
	url: `${siteBase}/affiliate/`,
	description:
		'Aktualne promocje bankowe, bonusy powitalne i oferty partnerskie w jednym miejscu.',
};

const schema = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: company.name || '机场测试',
	alternateName: 'jichangcesu.blog',
	description: company.description || seo.defaultDescription,
	image: `${siteBase}/og-image-v20261010.png`,
	'@id': `${siteBase}/#organization`,
	url: siteBase,
	email: company.email || 'contact@jichangcesu.blog',
	sameAs: getSocialUrls(company),
};

const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: '机场测试 (jichangcesu.blog)',
	alternateName: '2026 稳定机场推荐与晚高峰节点测速指南',
	url: siteBase,
	potentialAction: {
		'@type': 'SearchAction',
		target: `${siteBase}/brands/?q={search_term_string}`,
		'query-input': 'required name=search_term_string'
	}
};
---

{
	template === 'affiliate' ? (
		<script type="application/ld+json" set:html={jsonLd(affiliateWebsiteSchema)} />
	) : (
		<>
			<script type="application/ld+json" set:html={jsonLd(schema)} />
			<script type="application/ld+json" set:html={jsonLd(websiteSchema)} />
		</>
	)
}
