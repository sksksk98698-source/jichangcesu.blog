              {cat.badge}
            </a>
          ))}
        </div>
      </div>

      <!-- 主体内容与侧边栏布局 -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
        
        <!-- 左侧 8 列：万字 FAQ 内容核心区 -->
        <div class="lg:col-span-8 space-y-12">
          {faqCategories.map((cat, catIdx) => (
            <section id={cat.id} class="scroll-mt-24 rounded-2xl border border-brand-dark/10 bg-white/80 backdrop-blur-md p-6 sm:p-8 shadow-sm">
              <div class="mb-6 border-b border-brand-dark/10 pb-4">
                <span class="inline-block rounded-md bg-brand-primary/10 px-2.5 py-1 text-xs font-bold text-brand-primary mb-2">
                  {cat.badge}
                </span>
                <h2 class="text-xl sm:text-2xl font-bold text-brand-dark">
                  {cat.title}
                </h2>
                <p class="mt-2 text-xs sm:text-sm text-brand-dark/70 leading-relaxed">
                  {cat.desc}
                </p>
              </div>

              <!-- 问答手风琴列表 -->
              <div class="space-y-4">
                {cat.questions.map((item, qIdx) => (
                  <details
                    class="group rounded-xl border border-brand-dark/10 bg-brand-page/50 p-4 transition-all duration-200 open:border-brand-primary/40 open:bg-white"
                    open={catIdx === 0 && qIdx === 0 ? true : undefined}
